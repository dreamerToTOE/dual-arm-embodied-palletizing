  "causal_policy": {
    "join": "latest runtime row with physics_step <= visual receipt step and time_s <= visual receipt time_s; receipt alignment only, not exposure alignment",
    "future_samples": "rejected",
    "oracle_leakage": "Cube GT and PhysX contacts excluded from causal estimator inputs",
    "dynamic_limit": "camera writer wall latency is recorded; exposure-level RGB/depth/command synchronization is not established"
  },
  "audit_findings": [
    {
      "id": "GT_VELOCITY_LEAK",
      "source": "research/stage_b_vision_contact_r2b/observer/runtime_adapter.py::runtime_receipt_from_trace",
      "finding": "cube_velocity_m_s is copied to observed_cube_velocity_x_m_s and enters controller_reference; old causal payload excludes contact pairs but not this GT velocity. Prior R2 E0/E1 causal claim is qualified. R3 does not import that adapter or field."
    },
    {
      "id": "GT_PHASE_LABELS",
      "source": "research/stage_b_vision_contact_r2b/scripts/qualify_physical_camera.py::phase",
      "finding": "visual_detections.phase is derived from Cube GT and suction. R3 discards it and only uses executor event intervals when available."
    },
    {
      "id": "K_ASPECT_MISMATCH",
      "source": "Isaac Sim 4.5 Camera.get_vertical_aperture/get_intrinsics_matrix",
      "finding": "SDK effective vertical aperture derives from horizontal aperture times height/width. Fixed 36x24 authored metadata produces legacy fy=600, SDK square-pixel K gives fy=711.111. Bounded readback confirms."
    },
    {
      "id": "MARKER_OFFSET",
      "source": "r2b_camera_observer_smoke.py::make_marker",
      "finding": "Legacy rendered cells have front plane +61.5mm, whereas old evaluator used +61mm. R3 freezes 61.5mm for both V0 and V1."
    },
    {
      "id": "TCP_NOT_INDEPENDENT_FK",
      "source": "PhysicalTrace._tcp",
      "finding": "tcp_world_m reads the simulated TCP prim transform, not a fresh independent q-to-URDF FK calculation. Treat as simulated robot-link pose; FK fusion validation belongs to P2."
    },
    {
      "id": "CALLBACK_TIMING",
      "source": "PhysicalTrace._contact_report",
      "finding": "Contact reports use current self.step/time_s; subscription ordering relative to post-step is not certified, possible one-step assignment ambiguity. Impulse and penetration proxies are not measured loaded force."
    },
    {
      "id": "LEGACY_CONTROLLER_GT",
      "source": "Task26BatchedFeedBridge._publish -> /task27/cube_poses -> C++ CubeBuffer",
      "finding": "Existing Task27 controller consumes simulator Cube GT for planning/push; R3 A/B is a separate non-actuating path, not a GT-free Task27 controller."
    }
  ],
  "raw_data_policy": "large RGB/depth/JSONL files remain in local sensor-pipeline worktrees and are not copied into Git"
}
