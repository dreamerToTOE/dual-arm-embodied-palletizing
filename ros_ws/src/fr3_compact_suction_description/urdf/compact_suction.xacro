<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    项目自定义紧凑顶部吸盘。
    几何尺寸与 Isaac Sim Task04/Task05 基线保持一致：
    - stem: radius=6 mm, length=99 mm
    - cup : radius=10 mm, length=6 mm
    - TCP : parent link +Z 方向 105 mm
  -->
  <xacro:macro name="compact_suction" params="parent_link prefix:=''">
    <link name="${prefix}compact_suction">
      <visual name="stem_visual">
        <origin xyz="0 0 0.0495" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.006" length="0.099"/>
        </geometry>
        <material name="compact_suction_stem_gray">
          <color rgba="0.25 0.25 0.25 1.0"/>
        </material>
      </visual>
      <collision name="stem_collision">
        <origin xyz="0 0 0.0495" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.006" length="0.099"/>
        </geometry>
      </collision>

      <visual name="cup_visual">
        <origin xyz="0 0 0.102" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.010" length="0.006"/>
        </geometry>
        <material name="compact_suction_cup_black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
      <collision name="cup_collision">
        <origin xyz="0 0 0.102" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.010" length="0.006"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}compact_suction_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}compact_suction"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}compact_suction_tcp"/>
    <joint name="${prefix}compact_suction_tcp_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}compact_suction_tcp"/>
      <origin xyz="0 0 0.105" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
