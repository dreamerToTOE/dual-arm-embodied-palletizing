<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dual_fr3_gripper">
  <!--
    Task23 双 FR3 + 官方二指夹爪 SRDF。
    手指保持在 RobotModel 中但不并入 7-DOF arm group；执行器会把真实开闭
    finger state 写入 RobotState，从而使携物/推送阶段的碰撞包络真实有效。
  -->
  <group name="left_arm">
    <chain base_link="left_fr3_link0" tip_link="left_fr3_hand_tcp"/>
  </group>
  <group name="right_arm">
    <chain base_link="right_fr3_link0" tip_link="right_fr3_hand_tcp"/>
  </group>
  <group name="dual_arm">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>
  <group name="left_hand">
    <joint name="left_fr3_finger_joint1"/>
  </group>
  <group name="right_hand">
    <joint name="right_fr3_finger_joint1"/>
  </group>
  <end_effector name="left_gripper" parent_link="left_fr3_hand_tcp" group="left_hand" parent_group="left_arm"/>
  <end_effector name="right_gripper" parent_link="right_fr3_hand_tcp" group="right_hand" parent_group="right_arm"/>

  <group_state name="ready" group="left_arm">
    <joint name="left_fr3_joint1" value="0"/>
    <joint name="left_fr3_joint2" value="-0.78539816339"/>
    <joint name="left_fr3_joint3" value="0"/>
    <joint name="left_fr3_joint4" value="-2.35619449019"/>
    <joint name="left_fr3_joint5" value="0"/>
    <joint name="left_fr3_joint6" value="1.57079632679"/>
    <joint name="left_fr3_joint7" value="0.78539816339"/>
  </group_state>
  <group_state name="ready" group="right_arm">
    <joint name="right_fr3_joint1" value="0"/>
    <joint name="right_fr3_joint2" value="-0.78539816339"/>
    <joint name="right_fr3_joint3" value="0"/>
    <joint name="right_fr3_joint4" value="-2.35619449019"/>
    <joint name="right_fr3_joint5" value="0"/>
    <joint name="right_fr3_joint6" value="1.57079632679"/>
    <joint name="right_fr3_joint7" value="0.78539816339"/>
  </group_state>

  <xacro:macro name="fr3_internal_collision_matrix" params="p">
    <disable_collisions link1="${p}link0" link2="${p}link1" reason="Adjacent"/>
    <disable_collisions link1="${p}link0" link2="${p}link2" reason="Never"/>
    <disable_collisions link1="${p}link0" link2="${p}link3" reason="Never"/>
    <disable_collisions link1="${p}link0" link2="${p}link4" reason="Never"/>
    <disable_collisions link1="${p}link1" link2="${p}link2" reason="Adjacent"/>
    <disable_collisions link1="${p}link1" link2="${p}link3" reason="Never"/>
    <disable_collisions link1="${p}link1" link2="${p}link4" reason="Never"/>
    <disable_collisions link1="${p}link2" link2="${p}link3" reason="Adjacent"/>
    <disable_collisions link1="${p}link2" link2="${p}link4" reason="Never"/>
    <disable_collisions link1="${p}link2" link2="${p}link6" reason="Never"/>
    <disable_collisions link1="${p}link3" link2="${p}link4" reason="Adjacent"/>
    <disable_collisions link1="${p}link3" link2="${p}link5" reason="Never"/>
    <disable_collisions link1="${p}link3" link2="${p}link6" reason="Never"/>
    <disable_collisions link1="${p}link3" link2="${p}link7" reason="Never"/>
    <disable_collisions link1="${p}link4" link2="${p}link5" reason="Adjacent"/>
    <disable_collisions link1="${p}link4" link2="${p}link6" reason="Never"/>
    <disable_collisions link1="${p}link4" link2="${p}link7" reason="Never"/>
    <disable_collisions link1="${p}link4" link2="${p}link8" reason="Never"/>
    <disable_collisions link1="${p}link5" link2="${p}link6" reason="Adjacent"/>
    <disable_collisions link1="${p}link5" link2="${p}link7" reason="Never"/>
    <disable_collisions link1="${p}link6" link2="${p}link7" reason="Adjacent"/>
    <disable_collisions link1="${p}link6" link2="${p}link8" reason="Default"/>
    <disable_collisions link1="${p}link7" link2="${p}link8" reason="Adjacent"/>
  </xacro:macro>
  <xacro:macro name="fr3_hand_collision_matrix" params="p">
    <disable_collisions link1="${p}hand" link2="${p}leftfinger" reason="Adjacent"/>
    <disable_collisions link1="${p}hand" link2="${p}rightfinger" reason="Adjacent"/>
    <disable_collisions link1="${p}leftfinger" link2="${p}rightfinger" reason="Default"/>
    <disable_collisions link1="${p}leftfinger" link2="${p}link3" reason="Never"/>
    <disable_collisions link1="${p}leftfinger" link2="${p}link4" reason="Never"/>
    <disable_collisions link1="${p}leftfinger" link2="${p}link6" reason="Never"/>
    <disable_collisions link1="${p}leftfinger" link2="${p}link7" reason="Never"/>
    <disable_collisions link1="${p}leftfinger" link2="${p}link8" reason="Never"/>
    <disable_collisions link1="${p}link3" link2="${p}rightfinger" reason="Never"/>
    <disable_collisions link1="${p}link4" link2="${p}rightfinger" reason="Never"/>
    <disable_collisions link1="${p}link6" link2="${p}rightfinger" reason="Never"/>
    <disable_collisions link1="${p}link7" link2="${p}rightfinger" reason="Never"/>
    <disable_collisions link1="${p}link8" link2="${p}rightfinger" reason="Never"/>
  </xacro:macro>
  <xacro:fr3_internal_collision_matrix p="left_fr3_"/>
  <xacro:fr3_internal_collision_matrix p="right_fr3_"/>
  <xacro:fr3_hand_collision_matrix p="left_fr3_"/>
  <xacro:fr3_hand_collision_matrix p="right_fr3_"/>

  <!-- 不关闭左右两臂之间的碰撞；Task23 的供料臂和推料臂必须真实相互避障。 -->
</robot>
