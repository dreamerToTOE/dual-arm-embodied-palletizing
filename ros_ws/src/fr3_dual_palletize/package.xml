<?xml version="1.0"?>
<package format="3">
  <name>fr3_dual_palletize</name>
  <version>0.1.0</version>
  <description>Modular dual-FR3 palletizing primitives, Task07 loose coordination, and Task08 spatiotemporal conflict detection.</description>

  <maintainer email="noreply@example.com">dual-arm-embodied-palletizing</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning_interface</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
